# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# O .env não vai para o Git — cada pessoa tem o seu.
#
# Onde achar: painel do Supabase → Settings → API Keys
#
# O prefixo EXPO_PUBLIC_ é obrigatório: sem ele o Expo não expõe a variável
# para o código do app.

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Use a chave "anon" / "publishable". Ela é pública por natureza — o que
# protege os dados são as políticas de acesso (RLS) definidas no banco.
#
# NUNCA coloque aqui a chave "service_role": ela ignora todas as políticas de
# acesso, e tudo que entra no app pode ser lido por quem usa o app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
